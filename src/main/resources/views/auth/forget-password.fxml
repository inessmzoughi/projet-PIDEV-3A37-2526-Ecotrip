<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.esprit.controller.auth.ForgotPasswordController"
           styleClass="auth-root"
           alignment="CENTER">

    <!-- Full-screen green background -->
    <VBox styleClass="auth-bg" alignment="CENTER" spacing="0">

        <VBox styleClass="auth-card" maxWidth="440" spacing="0">

            <!-- Header -->
            <VBox styleClass="auth-card-header" alignment="CENTER" spacing="10">
                <padding><Insets top="32" bottom="28" left="32" right="32"/></padding>
                <StackPane styleClass="auth-header-icon">
                    <Label text="🔑" style="-fx-font-size:28px;"/>
                </StackPane>
                <Label text="Mot de passe oublié ?" styleClass="auth-card-title"/>
                <Label text="Entrez votre email pour recevoir un code de réinitialisation."
                       styleClass="auth-card-sub" wrapText="true"/>
            </VBox>

            <!-- Body -->
            <VBox styleClass="auth-card-body" spacing="18">
                <padding><Insets top="28" bottom="8" left="32" right="32"/></padding>

                <!-- Success message (step 1 done) -->
                <VBox fx:id="successBox" managed="false" visible="false"
                      styleClass="auth-success-box" spacing="8" alignment="CENTER">
                    <Label text="✅" style="-fx-font-size:36px;"/>
                    <Label text="Email envoyé !" styleClass="auth-success-title"/>
                    <Label fx:id="successDetail"
                           text="Vérifiez votre boite email et copiez le code reçu."
                           styleClass="auth-success-sub" wrapText="true"/>
                </VBox>

                <!-- Error message -->
                <Label fx:id="errorLabel"
                       styleClass="auth-error-msg"
                       managed="false" visible="false" wrapText="true"/>

                <!-- STEP 1: Email entry -->
                <VBox fx:id="step1Box" spacing="18">

                    <VBox spacing="6">
                        <Label text="ADRESSE EMAIL" styleClass="auth-field-label"/>
                        <TextField fx:id="emailField"
                                   styleClass="auth-input"
                                   promptText="votre@email.com"/>
                        <Label fx:id="errEmail" styleClass="auth-field-error"
                               managed="false" visible="false"/>
                    </VBox>

                    <Button fx:id="btnSendCode"
                            text="📨  Envoyer le code"
                            styleClass="auth-btn-primary"
                            maxWidth="Infinity"
                            onAction="#onSendCode"/>
                    <!-- Not found box — hidden by default -->
                    <VBox fx:id="notFoundBox" spacing="12" alignment="CENTER"
                          managed="false" visible="false"
                          style="-fx-background-color:#fff7ed;
             -fx-background-radius:12;
             -fx-border-color:#fed7aa;
             -fx-border-width:1;
             -fx-border-radius:12;
             -fx-padding:16;">

                        <Label text="Vous n'avez pas encore de compte ?"
                               style="-fx-font-size:13px;-fx-text-fill:#92400e;-fx-font-weight:bold;"/>
                        <Label text="Inscrivez-vous gratuitement et commencez à explorer EcoTrip."
                               style="-fx-font-size:12px;-fx-text-fill:#b45309;"
                               wrapText="true"/>
                        <Button text="→  Créer un compte gratuit"
                                onAction="#onGoToRegister"
                                style="-fx-background-color:#ea580c;-fx-text-fill:white;
                   -fx-font-weight:bold;-fx-font-size:13px;
                   -fx-background-radius:8;-fx-padding:9 18;
                   -fx-cursor:hand;-fx-border-width:0;"/>
                    </VBox>
                </VBox>

                <!-- STEP 2: Token + new password (shown after email sent) -->
                <VBox fx:id="step2Box" spacing="18"
                      managed="false" visible="false">

                    <!-- Info tip -->
                    <HBox styleClass="auth-info-tip" spacing="10" alignment="CENTER_LEFT">
                        <Label text="ℹ" style="-fx-font-size:15px;-fx-text-fill:#0284c7;"/>
                        <Label text="Collez le code reçu par email ci-dessous."
                               styleClass="auth-tip-text" wrapText="true"
                               HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Token field -->
                    <VBox spacing="6">
                        <Label text="CODE REÇU PAR EMAIL" styleClass="auth-field-label"/>
                        <TextField fx:id="tokenField"
                                   styleClass="auth-input auth-input-mono"
                                   promptText="Collez le code ici..."/>
                        <Label fx:id="errToken" styleClass="auth-field-error"
                               managed="false" visible="false"/>
                    </VBox>

                    <!-- New password -->
                    <VBox spacing="6">
                        <Label text="NOUVEAU MOT DE PASSE" styleClass="auth-field-label"/>
                        <PasswordField fx:id="newPasswordField"
                                       styleClass="auth-input"
                                       promptText="Minimum 6 caractères"/>
                        <Label fx:id="errNewPassword" styleClass="auth-field-error"
                               managed="false" visible="false"/>
                    </VBox>

                    <!-- Confirm password -->
                    <VBox spacing="6">
                        <Label text="CONFIRMER LE MOT DE PASSE" styleClass="auth-field-label"/>
                        <PasswordField fx:id="confirmPasswordField"
                                       styleClass="auth-input"
                                       promptText="Répétez le mot de passe"/>
                        <Label fx:id="errConfirmPassword" styleClass="auth-field-error"
                               managed="false" visible="false"/>
                    </VBox>

                    <Button fx:id="btnResetPassword"
                            text="🔒  Réinitialiser le mot de passe"
                            styleClass="auth-btn-primary"
                            maxWidth="Infinity"
                            onAction="#onResetPassword"/>

                    <!-- Resend code link -->
                    <Button text="↺  Renvoyer un nouveau code"
                            styleClass="auth-btn-link"
                            onAction="#onResendCode"
                            maxWidth="Infinity"/>

                </VBox>

            </VBox>

            <!-- Footer -->
            <VBox styleClass="auth-card-footer" alignment="CENTER" spacing="0">
                <padding><Insets top="16" bottom="24" left="32" right="32"/></padding>
                <Button text="← Retour à la connexion"
                        styleClass="auth-btn-back"
                        maxWidth="Infinity"
                        onAction="#onBackToLogin"/>
            </VBox>

        </VBox>
    </VBox>

</StackPane>