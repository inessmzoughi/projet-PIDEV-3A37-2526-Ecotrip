<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controller.back.hebergement.ModerationAvisController"
            styleClass="root-pane">
    <center>
        <VBox styleClass="main-content">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="20">
                    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                    <!-- Titre + bouton retour -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="← Retour aux Hébergements"
                                onAction="#onRetourHebergements"
                                style="-fx-background-color:#e2e8f0;
                                       -fx-text-fill:#334155;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:8;
                                       -fx-cursor:hand;
                                       -fx-padding:7 16 7 16;
                                       -fx-border-width:0;
                                       -fx-font-size:12px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="💬  Modération des Avis"
                               style="-fx-font-size:22px; -fx-font-weight:bold;
                                      -fx-text-fill:#0f172a;"/>
                        <Label fx:id="lblBadge" text="0"
                               style="-fx-background-color:#fde68a;
                                      -fx-text-fill:#854d0e;
                                      -fx-font-weight:bold;
                                      -fx-font-size:12px;
                                      -fx-background-radius:12;
                                      -fx-padding:3 10 3 10;"/>
                    </HBox>

                    <Label text="Approuvez ou rejetez les avis soumis par les utilisateurs."
                           style="-fx-font-size:13px; -fx-text-fill:#64748b;"/>

                    <Separator/>

                    <!-- Liste avis en attente -->
                    <VBox fx:id="avisContainer" spacing="14"/>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
