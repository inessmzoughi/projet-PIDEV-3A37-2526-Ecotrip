<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controller.front.MesFavorisController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="front-scroll">

    <VBox styleClass="heb-page" spacing="0">

        <!-- ══ HERO ══ -->
        <VBox styleClass="heb-hero" alignment="CENTER" spacing="14">
            <padding><Insets top="80" bottom="80" left="40" right="40"/></padding>
            <Label text="❤️  Mes Hébergements Favoris" styleClass="heb-hero-title"/>
            <Label fx:id="lblCount" text="" styleClass="heb-hero-sub"/>
        </VBox>

        <!-- ══ RÉSULTATS HEADER ══ -->
        <HBox alignment="CENTER_LEFT">
            <padding><Insets top="24" bottom="12" left="40" right="40"/></padding>
            <Label fx:id="resultCountLabel" text="" styleClass="heb-result-count"/>
        </HBox>

        <!-- ══ CARTES ══ -->
        <FlowPane fx:id="favorisContainer"
                  hgap="28" vgap="28"
                  styleClass="heb-cards-pane">
            <padding><Insets top="0" bottom="20" left="40" right="40"/></padding>
        </FlowPane>

        <!-- ══ EMPTY STATE ══ -->
        <VBox fx:id="emptyState" alignment="CENTER" spacing="16"
              managed="false" visible="false"
              styleClass="heb-empty">
            <padding><Insets top="60" bottom="60"/></padding>
            <Label text="❤️" styleClass="heb-empty-icon"/>
            <Label text="Aucun Favori Trouvé" styleClass="heb-empty-title"/>
            <Label text="Explorez les hébergements et sauvegardez vos préférés"
                   styleClass="heb-empty-sub"/>
            <Button text="🏨  Explorer les hébergements"
                    styleClass="heb-clear-btn"
                    onAction="#onRetour"/>
        </VBox>

        <!-- ══ FOOTER ══ -->
        <fx:include source="../components/front-footer.fxml"/>

    </VBox>
</ScrollPane>