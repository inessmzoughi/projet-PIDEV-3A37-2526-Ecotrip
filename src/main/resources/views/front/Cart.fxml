<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.lang.String?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controller.front.CartController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="front-scroll">

    <VBox styleClass="heb-page" spacing="0">

        <!-- ══ HERO ══ -->
        <VBox styleClass="heb-hero" alignment="CENTER" spacing="14">
            <padding><Insets top="60" bottom="60" left="40" right="40"/></padding>
            <Label fx:id="lblHeroTitle" text="Mon Panier" styleClass="heb-hero-title"/>
            <Label fx:id="lblHeroSub"  text="Verifiez vos articles avant de proceder au paiement"
                   styleClass="heb-hero-sub"/>
        </VBox>

        <!-- ══ BARRE LANGUE ══ -->
        <VBox styleClass="heb-filters-container">
            <padding><Insets top="16" bottom="16" left="40" right="40"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <ComboBox fx:id="languageSelect"
                          styleClass="heb-filter-input"
                          prefWidth="150"
                          style="-fx-font-size: 13px;"/>
            </HBox>
        </VBox>

        <!-- ══ CONTENU : articles + récapitulatif ══ -->
        <HBox fx:id="contentBox" spacing="24" alignment="TOP_CENTER">
            <padding><Insets top="24" bottom="32" left="40" right="40"/></padding>

            <!-- Liste des articles (remplie dynamiquement) -->
            <VBox fx:id="itemsContainer" spacing="16" HBox.hgrow="ALWAYS"/>

            <!-- Récapitulatif -->
            <VBox fx:id="summaryBox" spacing="14" prefWidth="320"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-border-radius: 14;
                         -fx-border-color: #e0e0e0;
                         -fx-border-width: 1;
                         -fx-padding: 24;">

                <Label fx:id="lblRecap" text="Recapitulatif"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d5a1b;"/>
                <Separator/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblNbArticles" text="Nombre d'articles :"
                           style="-fx-text-fill: #666; -fx-font-size: 13px;"/>
                    <Label fx:id="labelCount" text="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #2d5a1b;"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblTotal" text="Total :"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d5a1b;"/>
                    <Label fx:id="labelTotal" text="0.00 TND"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4a7c3f;"/>
                </HBox>

                <Separator/>

                <Label fx:id="lblModePaiement" text="Mode de paiement"
                       style="-fx-font-weight: bold; -fx-text-fill: #2d5a1b; -fx-font-size: 14px;"/>

                <!-- FIX FINAL : pas d'emojis, style explicite, texte ASCII pur -->
                <RadioButton fx:id="rbCash"   text="Cash"
                             style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                <RadioButton fx:id="rbCarte"  text="Par carte bancaire"
                             style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                <RadioButton fx:id="rbPaypal" text="PayPal"
                             style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>

                <Separator/>

                <Button fx:id="btnPayer"
                        text="Confirmer la commande"
                        maxWidth="Infinity"
                        onAction="#onConfirmer"
                        style="-fx-background-color: #2d5a1b;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-padding: 12 0 12 0;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <Button fx:id="btnVider"
                        text="Vider le panier"
                        maxWidth="Infinity"
                        onAction="#onVider"
                        style="-fx-background-color: #f5f5f5;
                               -fx-text-fill: #666;
                               -fx-font-size: 13px;
                               -fx-padding: 10 0 10 0;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <Button fx:id="btnExporterPDF"
                        text="Exporter la commande en PDF"
                        maxWidth="Infinity"
                        onAction="#onExporterPDF"
                        style="-fx-background-color: #1a3d73;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-padding: 12 0 12 0;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>
            </VBox>
        </HBox>

        <!-- ══ EMPTY STATE ══ -->
        <VBox fx:id="emptyState" alignment="CENTER" spacing="16"
              managed="false" visible="false">
            <padding><Insets top="80" bottom="80"/></padding>
            <Label text="Panier vide" style="-fx-font-size: 40px; -fx-text-fill: #2d5a1b;"/>
            <Label fx:id="lblEmptyTitle" text="Votre panier est vide"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d5a1b;"/>
            <Label fx:id="lblEmptySub"   text="Retournez a la boutique pour ajouter des produits"
                   style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
        </VBox>

    </VBox>
</ScrollPane>